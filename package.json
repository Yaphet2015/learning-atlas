{
  "name": "studyboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first AI learning canvas for macOS with concept maps, contextual conversations, and Markdown / PNG export.",
  "author": "Studyboard contributors",
  "license": "UNLICENSED",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env STUDYBOARD_DEV_SERVER=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:mac": "pnpm run build && electron-builder --mac --arm64",
    "dist:dir": "pnpm run build && electron-builder --dir",
    "format": "prettier --write src electron tests *.ts *.json .github/workflows/*.yml docs/*.md README.md"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@xyflow/react": "12.12.0",
    "lucide-react": "0.468.0",
    "lxgw-wenkai-webfont": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "app.studyboard.desktop",
    "productName": "Studyboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns"
    },
    "artifactName": "Studyboard-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yaphet2015/studyboard.git"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "homepage": "https://github.com/Yaphet2015/studyboard#readme",
  "bugs": {
    "url": "https://github.com/Yaphet2015/studyboard/issues"
  },
  "keywords": [
    "studyboard",
    "visual-learning",
    "ai-learning",
    "concept-map",
    "knowledge-map",
    "whiteboard",
    "local-first",
    "macos",
    "electron"
  ]
}
