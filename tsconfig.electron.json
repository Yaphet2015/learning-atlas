{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-electron",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["electron/**/*.ts", "src/shared/**/*.ts", "electron/**/*.cts"]
}
